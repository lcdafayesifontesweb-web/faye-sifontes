# Sanity.io — SS Consultores
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Token con permisos de escritura (Editor) para registrar inscripciones
# Crear en: sanity.io/manage → API → Tokens
SANITY_API_TOKEN=

# Alertas de inscripción (Resend)
RESEND_API_KEY=
# Remitente con dominio verificado en Resend
RESEND_FROM_EMAIL=admin@lcdafayesifontes.com
# Destinatarios del aviso interno de nueva inscripcion (separados por coma).
# Deben estar en un dominio DISTINTO al del remitente: si coincide, Zoho
# descarta el correo por su proteccion anti-spoofing y el aviso nunca llega.
# Si se deja vacio se usa lcdafayesifontesweb@gmail.com.
ADMIN_NOTIFICATION_EMAILS=

# Dominio público (botón Studio + logo en correos)
NEXT_PUBLIC_SITE_URL=https://www.lcdafayesifontes.com

# Meta Pixel (opcional). El id ya viene por defecto en el codigo; solo hace
# falta definirlo aqui si cambia la cuenta publicitaria.
NEXT_PUBLIC_META_PIXEL_ID=

# Asistente virtual (Google Gemini)
GEMINI_API_KEY=
# Modelo fijado en route.ts: gemini-3.1-flash-lite (v1beta)
